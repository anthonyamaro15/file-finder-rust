# Scene 2, captioned by record.sh: initials find a folder too.
Output "/tmp/dm-rec/scene-2/"
Source "assets/demo/setup.tape"
Type "cd ~/work/geoid-ai/app/components && clear" Enter Sleep 500ms
Show

Sleep 400ms
Type "ff" Sleep 150ms Enter Sleep 300ms
Type "p" Sleep 50ms
Space Sleep 100ms Type "/" Sleep 150ms
Type@140ms "ffr" Sleep 1.2s
Enter Sleep 500ms
Type "ls" Enter Sleep 1.4s
