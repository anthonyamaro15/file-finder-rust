# Scene 3, captioned by record.sh: the index manager switches off the Go module
# cache that fills most of the index.
Output "/tmp/dm-rec/scene-3/"
Source "assets/demo/setup.tape"
Type "cd ~/Projects/file-finder-rust && clear" Enter Sleep 500ms
Show

Sleep 400ms
Type "ff" Sleep 150ms Enter Sleep 300ms
Space Sleep 100ms Type "i" Sleep 1.8s
Space Sleep 1.8s
Enter Sleep 1.2s
